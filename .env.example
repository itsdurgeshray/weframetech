# Copy to .env.local for local dev; add the same keys in Vercel > Project > Settings > Environment Variables.

# ---------- Public (shipped to the browser) ----------
# Calendar shown on the thank-you page AFTER payment (Cal.com / Calendly link), one per offer.
# Name and email are added to the URL so the booking form is pre-filled.
NEXT_PUBLIC_BOOKING_URL=            # fallback for any offer without its own calendar
NEXT_PUBLIC_TELEHEALTH_BOOKING_URL=
NEXT_PUBLIC_MFG_SALES_BOOKING_URL=
NEXT_PUBLIC_MFG_AI_BOOKING_URL=
# YouTube video IDs (the part after watch?v=), per offer
NEXT_PUBLIC_VSL_YOUTUBE_ID=         # telehealth: hero VSL (defaults to iHkaJAG2Ans)
NEXT_PUBLIC_EXPLAINER_YOUTUBE_ID=   # telehealth: "Watch the 7-Minute Video Before Applying" (defaults to iHkaJAG2Ans)
NEXT_PUBLIC_MFG_SALES_VSL_ID=       # manufacturing sales channel: hero VSL
NEXT_PUBLIC_MFG_SALES_EXPLAINER_ID= # manufacturing sales channel: 10-minute case study
NEXT_PUBLIC_MFG_AI_VSL_ID=          # manufacturing AI growth: hero VSL
NEXT_PUBLIC_MFG_AI_EXPLAINER_ID=    # manufacturing AI growth: 10-minute case study

# ---------- Payment: Razorpay Payment Links (server only) ----------
# Prices: telehealth 499, manufacturing sales channel 99, manufacturing AI growth 199 INR (lib/offers/*).
# Without keys the funnel runs in demo mode (no real payment, flow still works end to end).
RAZORPAY_KEY_ID=                    # Dashboard > Account & Settings > API keys
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=            # Dashboard > Webhooks: URL https://<domain>/api/razorpay/webhook, event payment_link.paid

# ---------- Leads (server only) ----------
LEAD_WEBHOOK_URL=                   # lead events are POSTed here as JSON: lead.qualified (unpaid), payment.paid

# ---------- Phone OTP (optional, not used by the form) ----------
# demo   : no SMS, code is OTP_DEMO_CODE (default 123456). For previews only.
# twilio : Twilio Verify
# msg91  : MSG91 OTP API v5 (recommended for Indian numbers)
OTP_PROVIDER=demo
OTP_DEMO_CODE=123456
OTP_TOKEN_SECRET=                   # long random string; signs the "phone verified" proof sent with each lead

# Twilio Verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# MSG91 (not set up yet)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=                  # DLT-approved OTP template
MSG91_OTP_EXPIRY=10                 # minutes
MSG91_OTP_LENGTH=6                  # the form expects 6 digits
