# Copy to .env.local for local dev; add the same keys in Vercel > Project > Settings > Environment Variables.

# ---------- Public (shipped to the browser) ----------
NEXT_PUBLIC_BOOKING_URL=            # strategy-call link, e.g. https://cal.com/weframetech/strategy
NEXT_PUBLIC_VSL_YOUTUBE_ID=         # hero VSL
NEXT_PUBLIC_EXPLAINER_YOUTUBE_ID=   # "Watch the 7-Minute Video Before Applying"

# ---------- Leads (server only) ----------
LEAD_WEBHOOK_URL=                   # verified leads are POSTed here as JSON (CRM, Zapier, Make, Sheets...)

# ---------- Phone OTP (server only) ----------
# demo   : no SMS, code is OTP_DEMO_CODE (default 123456). For previews only.
# twilio : Twilio Verify
# msg91  : MSG91 OTP API v5 (recommended for Indian numbers)
OTP_PROVIDER=demo
OTP_DEMO_CODE=123456
OTP_TOKEN_SECRET=                   # long random string; signs the "phone verified" proof sent with each lead

# Twilio Verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# MSG91 (not set up yet)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=                  # DLT-approved OTP template
MSG91_OTP_EXPIRY=10                 # minutes
MSG91_OTP_LENGTH=6                  # the form expects 6 digits
